# Live football data (optional) ------------------------------------------------
#
# Without SPORTMONKS_API_TOKEN, FutDuel shows no real-world fixtures: the home
# page's "Next up" section is left out, and Fantasy is switched off and removed
# from the navigation. Nothing generated or out of date is shown in their place.
#
# All of these are read on the server only. Never prefix them with NEXT_PUBLIC_.
# Set them before `next build`: the navigation is rendered at build time.

# Sportmonks Football API v3 token. https://my.sportmonks.com
SPORTMONKS_API_TOKEN=

# Competitions for the home page fixtures, as Sportmonks league ids, comma
# separated (at most 10). Default: 8 (Premier League). Your plan must cover
# them; the free plan covers 271 (Danish Superliga) and 501 (Scottish Premiership).
SPORTMONKS_LEAGUE_IDS=8

# The competition Fantasy is played on. Default: the first id above.
SPORTMONKS_FANTASY_LEAGUE_ID=8

# Development only (`next dev`): point the client at a local mock such as
# scripts/mock-sportmonks.mjs to exercise the live, stale and failure states.
# Ignored when NODE_ENV is production and for any non-loopback address.
# SPORTMONKS_BASE_URL=http://127.0.0.1:4010/v3/football
